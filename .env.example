# Copia este archivo a .env y cambia TODOS los valores en producción.
# Genera secretos fuertes con:  openssl rand -hex 32

# --- Base de datos PostgreSQL ---
POSTGRES_USER=superclabe
POSTGRES_PASSWORD=cambia-esta-clave-fuerte
POSTGRES_DB=webapp_spei

# --- Cifrado AES-256 de datos sensibles (32 bytes en hex = 64 caracteres) ---
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Firma de tokens de sesión JWT ---
JWT_SECRET=cambia-este-secreto-jwt
JWT_EXPIRE_MIN=20

# --- Rendimiento del backend ---
WEB_CONCURRENCY=4
